# XEMM Lead-Lag — environment variables template
# ==================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
# `.env` is loaded automatically by `start_xemm_lead_lag.sh` and by the
# shadow tools in `tools/binance_sbe_*.py`.
#
# Never commit `.env`. Never paste secret values into chat / PR
# descriptions / commit messages.
# ==================================================================

# ---------- BitPreco fast-path routing (operators only) ----------
# Public endpoints (orderbook, ticker, trades) routed through the
# internal network. Set to empty (or leave commented) to use the
# public host. No fallback: if set, the internal host MUST be
# reachable; failure surfaces as IOError.
# BITPRECO_INTERNAL_BOOKS=http://54.232.138.12

# Private REST trading: FULL URL (not just host). All cmds POST here.
# BITPRECO_INTERNAL_API=https://backend.bitpreco.com/exchange/exch_api.php


# ---------- Binance SBE Market Data ----------
# The Ed25519 API key STRING that Binance returns when you upload your
# public key on the API portal. Goes verbatim into the X-MBX-APIKEY
# header on the SBE WebSocket. NOT the PEM private key.
# Used by the binance_sbe connector AND by tools/binance_sbe_shadow.py.
BINANCE_SBE_API_KEY=<paste-your-ed25519-api-key-string-here>


# ---------- BitPreco Redis pub/sub (Phase 0 exploration + Phase 2) ----
# BitPreco's internal bots use Redis pub/sub for live order/balance and
# orderbook updates instead of Phoenix WS. Phase 0 scripts in
# `tools/redis_probe/` use these credentials to capture real traffic in
# parallel with the legacy bot. Production data sources use the same
# vars when `bitpreco_data_backend=redis` in the connector config.
#
# Credentials provided by BitPreco directly — do NOT commit real values.
#
# NETWORK PATH: BitPreco's Redis lives on their private VPC
# (172.31.x.x). The bot host is reachable to this network directly
# (no internet hop) so TLS is OFF by default. Flip to true only if
# you ever connect from outside the VPC.
BITPRECO_REDIS_HOST=<bitpreco-redis-host>
BITPRECO_REDIS_PORT=56379
BITPRECO_REDIS_PASSWORD=<bitpreco-redis-password>
BITPRECO_REDIS_TLS=false
BITPRECO_REDIS_TLS_VERIFY=false
# Optional CA bundle path (only matters when TLS=true).
BITPRECO_REDIS_TLS_CA_PATH=
BITPRECO_REDIS_DB=0
# Numeric BitPreco user id (idBPBot in bitbots-js). Filled in by
# `tools/redis_probe/04_get_user_id.py` or pasted by hand.
BITPRECO_USER_ID=

# BitPreco REST auth_token — needed by scripts 04 + 05 to call
# authenticated endpoints (get_user_id, balance, executed_orders,
# open_orders, order_info). This is the concatenation
# `secret_key + api_key` (same value the connector builds at runtime
# in BitprecoAuth._add_auth_token_to_data). Plain text here ONLY for
# the probe; .env is gitignored. NEVER commit real values.
BITPRECO_API_AUTHTOKEN=
