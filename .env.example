# XEMM Lead-Lag — environment variables template
# ==================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
# `.env` is loaded automatically by `start_xemm_lead_lag.sh` and by the
# shadow tools in `tools/binance_sbe_*.py`.
#
# Never commit `.env`. Never paste secret values into chat / PR
# descriptions / commit messages.
# ==================================================================

# ---------- BitPreco fast-path routing (operators only) ----------
# Public endpoints (orderbook, ticker, trades) routed through the
# internal network. Set to empty (or leave commented) to use the
# public host. No fallback: if set, the internal host MUST be
# reachable; failure surfaces as IOError.
# BITPRECO_INTERNAL_BOOKS=http://54.232.138.12

# Private REST trading: FULL URL (not just host). All cmds POST here.
# BITPRECO_INTERNAL_API=https://backend.bitpreco.com/exchange/exch_api.php


# ---------- Binance SBE Market Data ----------
# The Ed25519 API key STRING that Binance returns when you upload your
# public key on the API portal. Goes verbatim into the X-MBX-APIKEY
# header on the SBE WebSocket. NOT the PEM private key.
# Used by the binance_sbe connector AND by tools/binance_sbe_shadow.py.
BINANCE_SBE_API_KEY=<paste-your-ed25519-api-key-string-here>
